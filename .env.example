# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values you need.
# ─────────────────────────────────────────────────────────────────────────────

# Overrides the E2W mint address that ships in src/config/token.ts.
# Leave empty to use the committed mint — you only need this to point a
# deployment at a different token.
NEXT_PUBLIC_E2W_TOKEN_ADDRESS=

# Canonical origin, used for metadata, Open Graph tags and the sitemap.
# Defaults to https://earn2win.app when unset.
NEXT_PUBLIC_SITE_URL=
