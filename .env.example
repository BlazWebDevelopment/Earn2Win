# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values you need.
# ─────────────────────────────────────────────────────────────────────────────

# The E2W mint address on Solana.
# Leave empty to run in pre-launch mode: "Coming soon" states, clearly labelled
# demo chart data, and disabled pump.fun / Solscan links.
# Setting it switches the whole app to live market data automatically.
NEXT_PUBLIC_E2W_TOKEN_ADDRESS=

# Canonical origin, used for metadata, Open Graph tags and the sitemap.
# Defaults to https://earn2win.app when unset.
NEXT_PUBLIC_SITE_URL=
